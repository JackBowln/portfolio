{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm build)",
      "Bash(pnpm test*)",
      "Bash(pnpm check*)",
      "Bash(pnpm cf:types)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:migrate:local)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm view *)"
    ],
    "ask": [
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions *)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler secret *)",
      "Bash(*wrangler d1 * --remote*)",
      "Bash(*wrangler d1 time-travel *)",
      "Bash(*wrangler d1 create *)",
      "Bash(*wrangler d1 delete *)",
      "Bash(*wrangler r2 *)",
      "Bash(*wrangler kv *)",
      "Bash(*wrangler login*)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(npm install *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(gh repo create *)",
      "Bash(gh pr create *)",
      "Bash(gh workflow run *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(.dev.vars)",
      "Read(.dev.vars.*)",
      "Read(!.dev.vars.example)"
    ]
  }
}
