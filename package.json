{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev --config .output/server/wrangler.json --persist-to .wrangler/state",
    "preview:prod": "wrangler dev --config .output/server/wrangler.json --name portfolio-prodlike --persist-to .wrangler/state-prod --port 8788 --inspector-port 9230 --var ENVIRONMENT:production --var SITE_URL:http://localhost:8788 --var NUXT_PUBLIC_SITE_URL:http://localhost:8788",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cf:types": "wrangler types",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:workers": "vitest run --project workers",
    "test:api": "playwright test --project api --project api-prod",
    "test:e2e": "playwright test --project e2e --project e2e-mobile",
    "test:a11y": "playwright test --project a11y && playwright test --config playwright.dev.config.ts",
    "check:budgets": "node scripts/check-budgets.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/state",
    "db:seed": "node server/db/seed/dev.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "~10.6.0",
    "better-auth": "~1.7.13",
    "drizzle-orm": "~0.45.4",
    "nuxt": "~4.6.2",
    "vue": "~3.5.44",
    "vue-router": "~5.4.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@cloudflare/vitest-plugin": "~1.4.7",
    "@fontsource-variable/fraunces": "~5.3.0",
    "@fontsource-variable/inter": "~5.3.0",
    "@fontsource-variable/jetbrains-mono": "~5.3.0",
    "@nuxt/eslint": "~1.17.0",
    "@nuxt/test-utils": "~4.3.4",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/vite": "~4.3.3",
    "@types/node": "~24.19.2",
    "@vue/test-utils": "~2.5.1",
    "chrome-launcher": "~1.2.2",
    "drizzle-kit": "~0.31.11",
    "eslint": "~10.13.0",
    "happy-dom": "~21.0.4",
    "lighthouse": "~13.5.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "vitest": "~5.0.5",
    "vue-tsc": "~3.3.13",
    "wrangler": "^4.152.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "@cloudflare/vitest-plugin>zod": "~4.6.7",
      "miniflare>undici": "~7.30.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  }
}
