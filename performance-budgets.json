{
  "$comment": "docs/quality/performance-budgets.md §3–§4. Sizes in kB (1 kB = 1000 bytes, gzip), as Vite reports them. Initial JS = entry + the route's page and layout chunks + their static imports; other dynamic imports are excluded. E404 has no page chunk: app/error.vue is bundled in the entry. Lighthouse measures every route but E404 (`lighthouse: false`: not a 2xx document) on the production-like instance seeded by `pnpm db:seed:prodlike` (F11-T5); R3, R5 and R8 are its reference article and project.",
  "routes": {
    "R1": {
      "path": "/",
      "page": "pages/index.vue",
      "layout": "layouts/default.vue",
      "js": 125,
      "css": 30
    },
    "R2": {
      "path": "/blog",
      "page": "pages/blog/index.vue",
      "layout": "layouts/default.vue",
      "js": 127,
      "css": 30
    },
    "R3": {
      "path": "/blog/artigo-de-referencia",
      "page": "pages/blog/[slug].vue",
      "layout": "layouts/reading.vue",
      "noMotion": true,
      "js": 123,
      "css": 25
    },
    "R4": {
      "path": "/projetos",
      "page": "pages/projetos/index.vue",
      "layout": "layouts/default.vue",
      "js": 125,
      "css": 30
    },
    "R5": {
      "path": "/projetos/projeto-de-referencia",
      "page": "pages/projetos/[slug].vue",
      "layout": "layouts/default.vue",
      "js": 125,
      "css": 30
    },
    "R6": {
      "path": "/sobre",
      "page": "pages/sobre.vue",
      "layout": "layouts/default.vue",
      "js": 125,
      "css": 30
    },
    "R7": {
      "path": "/contato",
      "page": "pages/contato.vue",
      "layout": "layouts/default.vue",
      "js": 128,
      "css": 30
    },
    "R8": {
      "path": "/de/blog/artigo-de-referencia",
      "page": "pages/blog/[slug].vue",
      "layout": "layouts/reading.vue",
      "noMotion": true,
      "js": 123,
      "css": 25
    },
    "E404": {
      "path": "/__budget-not-found",
      "layout": "layouts/default.vue",
      "js": 125,
      "css": 30,
      "lighthouse": false
    }
  },
  "forbiddenInPublicRoutes": [
    "/admin/",
    "better-auth",
    "@simplewebauthn/",
    "@tiptap/",
    "/shiki/",
    "@shikijs/",
    "@jsquash/"
  ],
  "forbiddenContentInPublicRoutes": [
    "ProseMirror",
    "tiptap",
    "codeToHast",
    "ZodError",
    "admin-artigos"
  ],
  "lighthouse": {
    "minScores": {
      "mobile": {
        "performance": 95,
        "accessibility": 100,
        "best-practices": 100,
        "seo": 100
      },
      "desktop": {
        "performance": 98,
        "accessibility": 100,
        "best-practices": 100,
        "seo": 100
      }
    }
  }
}
